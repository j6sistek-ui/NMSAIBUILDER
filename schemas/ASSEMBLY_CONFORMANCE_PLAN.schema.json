{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASSEMBLY_CONFORMANCE_PLAN",
  "type": "object",
  "required": [
    "source_docs_rev",
    "assemblies"
  ],
  "properties": {
    "source_docs_rev": {
      "type": "string"
    },
    "assemblies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assembly_id",
          "method",
          "conformance_required",
          "validation_status"
        ]
      }
    }
  }
}