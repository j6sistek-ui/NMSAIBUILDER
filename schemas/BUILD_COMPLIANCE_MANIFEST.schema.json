{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BUILD_COMPLIANCE_MANIFEST",
  "type": "object",
  "required": [
    "build_name",
    "build_surface",
    "object_ids",
    "precedence_resolutions",
    "sources_checked",
    "compliance_statement"
  ],
  "properties": {
    "build_name": {
      "type": "string",
      "minLength": 1
    },
    "build_surface": {
      "enum": [
        "python",
        "blender"
      ]
    },
    "object_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "precedence_resolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "objectid",
          "governing_tier",
          "source_file",
          "source_ref",
          "method"
        ],
        "properties": {
          "objectid": {
            "type": "string"
          },
          "governing_tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "source_file": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "method": {
            "type": "string"
          }
        }
      }
    },
    "sources_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compliance_statement": {
      "type": "string",
      "minLength": 1
    }
  }
}