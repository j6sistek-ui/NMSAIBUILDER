{
 "note": "Single source of every ACTIVE version label. The release gate enforces each == release/VERSION.json current_version. Add a row when a new active label is introduced. Historical mentions (CHANGELOG, release notes, archive/, reports/, lineage fields) are NOT listed.",
 "locations": [
  {
   "file": "00_START_HERE_CURRENT.md",
   "pattern": "^#\\s+00 \u2014 START HERE\\s+\\((\\d+\\.\\d{2}\\.\\d{2})",
   "note": "title"
  },
  {
   "file": "00_START_HERE_CURRENT.md",
   "pattern": "Current baseline:\\s*`?(\\d+\\.\\d{2}\\.\\d{2})`?",
   "note": "baseline line"
  },
  {
   "file": "README.md",
   "pattern": "^#\\s+NMS Master Docs\\s+(\\d+\\.\\d{2}\\.\\d{2})",
   "note": "title"
  },
  {
   "file": "FILE_INVENTORY.md",
   "pattern": "^#\\s+NMS master docs\\s+(\\d+\\.\\d{2}\\.\\d{2})\\s+file inventory",
   "note": "title"
  },
  {
   "file": "validation/run_gate.py",
   "pattern": "run_gate\\.py\\s+\\(v(\\d+\\.\\d{2}\\.\\d{2})\\)",
   "note": "docstring banner"
  },
  {
   "file": "validation/run_gate.py",
   "pattern": "EXECUTABLE GATE \\(v(\\d+\\.\\d{2}\\.\\d{2})\\)",
   "note": "gate output banner"
  },
  {
   "file": "transfer_prompts/NMS_BUILDER_BOOTSTRAP_CURRENT.txt",
   "pattern": "Bootstrap Prompt\\s+(\\d+\\.\\d{2}\\.\\d{2})",
   "note": "bootstrap title"
  },
  {
   "file": "release/VERSION.json",
   "json_key": "current_version",
   "note": "version source of truth"
  },
  {
   "file": "release/VERSION.json",
   "json_key": "version",
   "note": "version mirror"
  },
  {
   "file": "PACKAGE_MANIFEST.json",
   "json_key": "version",
   "note": "manifest version"
  },
  {
   "file": "00_KICKOFF_INTAKE_GATE.md",
   "pattern": "^#\\s+00 \\u2014 KICKOFF / INTAKE GATE \\((\\d+\\.\\d{2}\\.\\d{2})",
   "note": "kickoff title"
  },
  {
   "file": "OPEN_TOPICS_LOG.md",
   "pattern": "Current active version:\\s*(\\d+\\.\\d{2}\\.\\d{2})",
   "note": "open topics active version"
  }
 ]
}